# Bot ko Harao — environment variables
# Copy to .env and fill in. NEVER commit .env.

# Monad testnet
MONAD_RPC_HTTP=https://testnet-rpc.monad.xyz   # public RPC; use a private one for a full room
MONAD_RPC_WSS=
CHAIN_ID=10143
CONTRACT_ADDRESS=

# Wallets (private keys, hex with 0x prefix)
OPERATOR_PK=               # deploy + settle
DRIP_PK=                   # funds burners
BOT_CHHOTA_PK=
BOT_BADA_PK=

# Bots: any OpenAI-compatible endpoint. Both tiers below are free and need no card.
BOT_CHHOTA_BASE_URL=https://api.groq.com/openai/v1
BOT_CHHOTA_API_KEY=        # console.groq.com, free tier
BOT_CHHOTA_MODEL=openai/gpt-oss-20b
BOT_CHHOTA_REASONING=low
BOT_BADA_BASE_URL=https://api.groq.com/openai/v1
BOT_BADA_API_KEY=          # same Groq key works (separate TPM limits per model)
BOT_BADA_MODEL=openai/gpt-oss-120b
BOT_BADA_REASONING=low

# Fallback LLM routers — both running locally, two independent failover paths.
# If a primary provider dies mid-demo, swap BOT_*_BASE_URL to one of these.
#
# OmniRoute:   npm install -g omniroute && omniroute         (port 20128)
# FreeLLMAPI:  git clone https://github.com/tashfeenahmed/freellmapi && docker compose up  (port 3000)
#
# Run both before hack day. If one router is also down, the other is still there.
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_KEY=             # set via INITIAL_PASSWORD on first run
FREELLMAPI_URL=http://localhost:3000/v1
FREELLMAPI_KEY=            # see freellmapi docs

# Game config
DRIP_MON=0.25
PAY_R_MON=0.02
PAY_G_MON=0.05
WRITE_S=30
SLOT_S=8
SLOTS=4
PUBLIC_URL=                # public address of the game, rendered as the QR
DEMO_MODE=0                # 1 = shorter timers, host hotkeys on
